# macOS
.DS_Store

# Local Claude Code settings
.claude/
# developer notes — kept local, not for the public repo
CLAUDE.md

# deliverables — pitch decks, TOR, presentations. Kept local, not for the public repo
เอกสารส่งมอบ/
*.pptx

# institutional source forms (CMU originals) — reference only, kept local
แบบฟอร์ม/

# local dev server launchers (start/stop) — personal convenience, not for the repo
# pattern rather than filenames: these are double-click scripts each person makes
# for their own machine, and the next one should not need a gitignore edit too
*.command

# กุญแจของ Firebase ฝั่งเซิร์ฟเวอร์ — ข้ามทุกสิทธิ์ได้ทั้งโปรเจกต์
# หลุดเมื่อไหร่ต้อง revoke ที่ Google Cloud ทันที ลบ commit อย่างเดียวไม่พอ
*service-account*.json
*serviceAccount*.json
firebase-adminsdk-*.json
.env
.env.*
# ของที่ firebase CLI สร้างระหว่างทาง
.firebase/
firebase-debug.log

# ค่าตั้งต้น Firebase ฝั่งเว็บ — ยังไม่ได้ import เข้าแอป และ repo ยังเป็น public
# ไม่ใช่ความลับตามสเปกของ Firebase แต่ยังไม่มีเหตุต้องฝากไว้ในประวัติถาวรตอนนี้
# เอาออกจากรายการนี้ได้เลยตอนเริ่มต่อ DB จริง (ดึงใหม่จาก Console ได้ตลอด)
js/firebase-config.js
